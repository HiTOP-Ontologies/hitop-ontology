    hitop:hasLevel "Component" ;
    hitop:hasTier <http://purl.org/hitop/factorizations/bass-ackwards/vV10bak#COLLGadOcd> ;
    skos:changeNote "Bridges: PF Problems"@en .

<http://purl.org/hitop/factorizations/bass-ackwards/vV10bak#COLLPF> a skos:Collection ;
