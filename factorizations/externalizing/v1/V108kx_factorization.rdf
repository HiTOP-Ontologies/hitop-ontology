  <rdf:Description rdf:about="http://purl.org/hitop/factorizations/externalizing/vV108kx">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Externalizing Superspectrum</rdfs:label>
    <owl:versionInfo>V108kx</owl:versionInfo>
    <owl:imports rdf:resource="http://purl.org/hitop"/>
