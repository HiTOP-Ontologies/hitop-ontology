  </owl:Ontology>
  <skos:Concept rdf:about="http://purl.org/hitop/factorizations/psychosis/vV10749#Emotionaldetachment">
    <hitop:hasLevel>Trait</hitop:hasLevel>
    <rdfs:label xml:lang="en">Emotional detachment</rdfs:label>
    <skos:relatedMatch rdf:resource="http://purl.org/hitop#T00BXK"/>
    <skos:scopeNote xml:lang="en">Partial overlap with the referenced core concept; neither equivalence nor a narrower or broader direction is asserted.</skos:scopeNote>
  </skos:Concept>
  <skos:Concept rdf:about="http://purl.org/hitop/factorizations/psychosis/vV10749#Romanticdisinterest">
    <hitop:hasLevel>Trait</hitop:hasLevel>
    <rdfs:label xml:lang="en">Romantic disinterest</rdfs:label>
    <skos:relatedMatch rdf:resource="http://purl.org/hitop#T00zDk"/>
    <skos:scopeNote xml:lang="en">Partial overlap with the referenced core concept; neither equivalence nor a narrower or broader direction is asserted.</skos:scopeNote>
  </skos:Concept>
</rdf:RDF>
