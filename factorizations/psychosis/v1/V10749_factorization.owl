<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns:dcterms="http://purl.org/dc/terms/" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:hitop="http://purl.org/hitop#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:skos="http://www.w3.org/2004/02/skos/core#">
  <rdf:Description rdf:about="http://purl.org/hitop#C00kEN">
    <hitop:hasLevel>Component</hitop:hasLevel>
    <rdfs:label xml:lang="en">Dissociation</rdfs:label>
    <rdfs:comment xml:lang="en">A mental process used to cope with stress or trauma, leading to a sense of detachment from one's surroundings or self.</rdfs:comment>
    <skos:changeNote xml:lang="en">provisional: true</skos:changeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/hitop#C00qSD">
    <hitop:hasLevel>Component</hitop:hasLevel>
    <rdfs:label xml:lang="en">Reality distortion</rdfs:label>
    <skos:altLabel xml:lang="en">Psychotic</skos:altLabel>
    <rdfs:comment xml:lang="en">A component characterized by symptoms of psychosis.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/hitop#C00rnS">
    <hitop:hasLevel>Component</hitop:hasLevel>
    <rdfs:label xml:lang="en">Disorganization</rdfs:label>
    <skos:altLabel xml:lang="en">Disorganized</skos:altLabel>
    <rdfs:comment xml:lang="en">A component characterized by disorganized thinking and behavior.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/hitop#C00sWr">
    <hitop:hasLevel>Component</hitop:hasLevel>
    <rdfs:label xml:lang="en">Inexpressivity</rdfs:label>
    <rdfs:comment xml:lang="en">A component characterized by a lack of emotional expression.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/hitop#C00tUQ">
    <hitop:hasLevel>Component</hitop:hasLevel>
    <rdfs:label xml:lang="en">Avolition</rdfs:label>
    <rdfs:comment xml:lang="en">A component characterized by a lack of motivation to initiate and sustain purposeful activities.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/hitop#S003TB">
    <hitop:hasLevel>Superspectrum</hitop:hasLevel>
    <rdfs:label xml:lang="en">Psychosis</rdfs:label>
    <rdfs:comment xml:lang="en">A superspectrum encompassing disturbances in reality testing and self-experience, including abnormalities of perception, belief, and thought such as hallucinations, delusions, disorganization, and related negative symptoms (e.g., avolition, blunted affect).</rdfs:comment>
    <hitop:hasTier>
      <rdf:Description rdf:about="http://purl.org/hitop#P003SL">
        <hitop:hasLevel>Spectrum</hitop:hasLevel>
        <rdfs:label xml:lang="en">Thought disorder</rdfs:label>
        <skos:altLabel xml:lang="en">Thought Disorder</skos:altLabel>
        <rdfs:comment xml:lang="en">Thought Disorder refers to a category of mental health conditions characterized by disorganized thinking, impaired reality testing, and disturbances in the form or content of thought.</rdfs:comment>
        <hitop:hasTier rdf:resource="http://purl.org/hitop#T00xLn"/>
        <hitop:hasTier rdf:resource="http://purl.org/hitop#T00wk6"/>
        <hitop:hasTier rdf:resource="http://purl.org/hitop#T00ua9"/>
        <hitop:hasTier rdf:resource="http://purl.org/hitop#U0050q"/>
        <hitop:hasTier rdf:resource="http://purl.org/hitop#C00kEN"/>
        <hitop:hasTier rdf:resource="http://purl.org/hitop#C00qSD"/>
        <hitop:hasTier rdf:resource="http://purl.org/hitop#C00rnS"/>
      </rdf:Description>
    </hitop:hasTier>
    <hitop:hasTier>
      <rdf:Description rdf:about="http://purl.org/hitop#P004R1">
        <hitop:hasLevel>Spectrum</hitop:hasLevel>
        <rdfs:label xml:lang="en">Detachment</rdfs:label>
        <rdfs:comment xml:lang="en">Detachment refers to a psychological state characterized by emotional distance and disengagement from social interactions.</rdfs:comment>
        <hitop:hasTier rdf:resource="http://purl.org/hitop/factorizations/psychosis/vV10749#Emotionaldetachment"/>
        <hitop:hasTier rdf:resource="http://purl.org/hitop#T01hQc"/>
        <hitop:hasTier rdf:resource="http://purl.org/hitop#T011K6"/>
        <hitop:hasTier rdf:resource="http://purl.org/hitop/factorizations/psychosis/vV10749#Romanticdisinterest"/>
        <hitop:hasTier rdf:resource="http://purl.org/hitop#C00sWr"/>
        <hitop:hasTier rdf:resource="http://purl.org/hitop#C00tUQ"/>
      </rdf:Description>
    </hitop:hasTier>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/hitop#T00ua9">
    <hitop:hasLevel>Trait</hitop:hasLevel>
    <rdfs:label xml:lang="en">Peculiarity</rdfs:label>
    <skos:altLabel xml:lang="en">Eccentricity</skos:altLabel>
    <rdfs:comment xml:lang="en">A trait characterized by unconventional or peculiar behavior.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/hitop#T00wk6">
    <hitop:hasLevel>Trait</hitop:hasLevel>
    <rdfs:label xml:lang="en">Unusual Beliefs and Experiences</rdfs:label>
    <skos:altLabel xml:lang="en">Unusual beliefs and experiences</skos:altLabel>
    <rdfs:comment xml:lang="en">A trait characterized by the presence of atypical beliefs and experiences.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/hitop#T00xLn">
    <hitop:hasLevel>Trait</hitop:hasLevel>
    <rdfs:label xml:lang="en">Fantasy proneness</rdfs:label>
    <rdfs:comment xml:lang="en">A trait characterized by a tendency to engage in vivid and complex fantasies.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/hitop#T011K6">
    <hitop:hasLevel>Trait</hitop:hasLevel>
    <rdfs:label xml:lang="en">Social withdrawal</rdfs:label>
    <skos:altLabel xml:lang="en">Withdrawal</skos:altLabel>
    <rdfs:comment xml:lang="en">A trait characterized by a tendency to retreat from social interactions and avoid engagement with others.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/hitop#T01hQc">
    <hitop:hasLevel>Trait</hitop:hasLevel>
    <rdfs:label xml:lang="en">Anhedonia (Trait)</rdfs:label>
    <rdfs:comment xml:lang="en">Anhedonia conceptualized as a Trait refers to a stable, enduring disposition toward diminished pleasure or interest in typically rewarding experiences.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/hitop#U0050q">
    <hitop:hasLevel>Component</hitop:hasLevel>
    <rdfs:label xml:lang="en">Mania</rdfs:label>
    <rdfs:comment xml:lang="en">Mania is characterized by elevated mood, increased activity, and impulsive behavior.</rdfs:comment>
    <skos:changeNote xml:lang="en">provisional: true</skos:changeNote>
  </rdf:Description>
  <owl:Ontology rdf:about="http://purl.org/hitop/factorizations/psychosis/vV10749">
