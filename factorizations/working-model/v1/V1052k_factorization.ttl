@prefix dcterms: <http://purl.org/dc/terms/> .

@prefix hitop: <http://purl.org/hitop#> .

@prefix owl: <http://www.w3.org/2002/07/owl#> .

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

    hitop:F001Hw rdfs:label "General Psychopathology"@en ;
    hitop:hasLevel "Factor" ;
    hitop:hasTier hitop:P001Y2 ,
    hitop:P002nf ,
    hitop:P003SL ,
    hitop:P004R1 ,
    hitop:S0013h ;
    rdfs:comment "General Psychopathology refers to the broad, overarching category of mental disorders and psychological symptoms that can manifest across different mental health conditions. It encompasses a wide range of psychological phenomena that are not specific to any single disorder but may contribute to or exacerbate multiple types of mental health issues. This category includes general symptoms and traits that are commonly observed in various psychiatric conditions, such as mood disturbances, anxiety, cognitive dysfunctions, and behavioral problems."@en .

<http://purl.org/hitop/factorizations/working-model/vV1052k> a owl:Ontology ;
    rdfs:label "HiTOP Working Model"@en ;
    dcterms:created "2026-07-07"^^xsd:date ;
    dcterms:creator "Dr. Rogério Blitz" ;
    dcterms:isVersionOf "0.1.0" ;
    dcterms:source "https://www.hitop-system.org/current-model" ;
    owl:imports <http://purl.org/hitop> ;
    owl:versionInfo "V1052k" ;
    skos:changeNote "status: draft"@en .

    hitop:C001qy rdfs:label "Conversion"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A component related to conversion disorders where psychological distress is expressed as physical symptoms."@en .

    hitop:C00217 rdfs:label "Somatization"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A component involving the expression of psychological distress through physical symptoms."@en .

    hitop:C0033z rdfs:label "Malaise"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A component related to general discomfort or unease."@en .

    hitop:C00416 rdfs:label "Head Pain"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A component related to headaches or other types of head pain."@en .

    hitop:C005Sv rdfs:label "Gastrointestinal"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A component related to gastrointestinal symptoms and disorders."@en .

    hitop:C006MD rdfs:label "Cognitive"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A component related to cognitive symptoms and dysfunctions."@en .

    hitop:C00JTU rdfs:label "Interactive anxiety"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Anxiety experienced in social interactions and group settings."@en .

    hitop:C00KL0 rdfs:label "Performance anxiety"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Anxiety related to performing tasks or activities, often in public or under observation."@en .

    hitop:C00LqY rdfs:label "Public places"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Fear or anxiety associated with being in public spaces."@en .

    hitop:C00Mpl rdfs:label "Enclosed spaces"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Fear or anxiety related to confined or small spaces."@en .

    hitop:C00N4I rdfs:label "Animal phobia"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Fear or anxiety related to animals."@en .

    hitop:C00OuR rdfs:label "Situational phobia"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Fear or anxiety related to specific situations or environments."@en .

    hitop:C00Pjp rdfs:label "Blood-injection-injury"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Fear or anxiety related to blood, injections, or injuries."@en .

    hitop:C00Q1t rdfs:label "Physiological panic"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Panic attacks characterized by physiological symptoms such as rapid heartbeat and sweating."@en .

    hitop:C00RGy rdfs:label "Psychological panic"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A component of psychological panic is an intense, overwhelming fear that triggers physical symptoms and a sense of losing control."@en .

    hitop:C00S9m rdfs:label "Cleaning"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Compulsive behaviors related to cleaning or hygiene."@en .

    hitop:C00TgL rdfs:label "Rituals"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Compulsive rituals or behaviors performed in a specific manner."@en .

    hitop:C00Urw rdfs:label "Checking"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Compulsive checking behaviors, such as repeatedly checking locks or appliances."@en .

    hitop:C00VHv rdfs:label "Dysphoria"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A state of generalized unhappiness or dissatisfaction."@en .

    hitop:C00WJc rdfs:label "Lassitude"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A state of physical or mental weariness and lack of energy."@en .

    hitop:C00XyI rdfs:label "Anhedonia"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Anhedonia conceptualized as a Component refers to a transient reduction in the capacity to experience pleasure, often emerging in response to acute stress or mood states."@en .

    hitop:C00Y8j rdfs:label "Insomnia"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Difficulty falling asleep or staying asleep, or waking up too early and not being able to go back to sleep."@en .

    hitop:C00ZyP rdfs:label "Suicidality"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "The presence of thoughts or behaviors related to suicide."@en .

    hitop:C00aMF rdfs:label "Agitation"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "State of being overly excited or disturbed, often resulting in restlessness or erratic behavior."@en .

    hitop:C00bEx rdfs:label "Retardation"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Slowed cognitive and physical processes, including thinking, speaking, and moving."@en .

    hitop:C00cSn rdfs:label "Appetite loss"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Reduction or loss of desire to eat, which can lead to weight loss."@en .

    hitop:C00dc1 rdfs:label "Appetite gain"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Increased desire to eat, which can lead to weight gain."@en .

    hitop:C00e0L rdfs:label "(low) Wellbeing"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A low level of mental and physical wellbeing, characterized by reduced feelings of happiness, contentment, and overall health."@en .

    hitop:C00fKQ rdfs:label "Generalized anxiety disorder symptoms"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A component of generalized anxiety disorder symptoms is excessive, persistent worry that interferes with daily life and is often accompanied by physical symptoms like restlessness and fatigue."@en .

    hitop:C00gvD rdfs:label "Re-experiencing"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Re-experiencing traumatic events through flashbacks, intrusive memories, or nightmares."@en .

    hitop:C00hPJ rdfs:label "Avoidance"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Efforts to avoid reminders or situations that are associated with traumatic experiences or stress."@en .

    hitop:C00iAh rdfs:label "Hyperarousal"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Increased physiological arousal, including symptoms such as hypervigilance, irritability, and difficulty sleeping."@en .

    hitop:C00jw5 rdfs:label "Numbing"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Emotional numbness or detachment from feelings as a response to overwhelming stress or trauma."@en .

    hitop:C00kEN rdfs:label "Dissociation"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A mental process used to cope with stress or trauma, leading to a sense of detachment from one's surroundings or self."@en .

    hitop:C00l5y rdfs:label "Irritability"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "State of being easily annoyed or angered, often with a low tolerance for frustration."@en .

    hitop:C00mpe rdfs:label "Pure obsessions"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Recurrent and persistent intrusive thoughts that cause significant distress, without accompanying compulsive behaviors."@en .

    hitop:C00nyb rdfs:label "Euphoric activation"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A state of heightened mood and increased energy, often associated with mania or hypomania."@en .

    hitop:C00oKM rdfs:label "Hyperactive cognition"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Increased cognitive activity, often characterized by racing thoughts and distractibility."@en .

    hitop:C00pnZ rdfs:label "Reckless overconfidence"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Excessive self-confidence leading to risky or impulsive behavior, often seen in manic episodes."@en .

    hitop:C00qSD rdfs:label "Psychotic"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A component characterized by symptoms of psychosis."@en .

    hitop:C00rnS rdfs:label "Disorganized"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A component characterized by disorganized thinking and behavior."@en .

    hitop:C00sWr rdfs:label "Inexpressivity"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A component characterized by a lack of emotional expression."@en .

    hitop:C00tUQ rdfs:label "Avolition"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "A component characterized by a lack of motivation to initiate and sustain purposeful activities."@en .

    hitop:C01DAb rdfs:label "Alcohol use"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "The consumption of alcoholic beverages, which may lead to problematic use."@en .

    hitop:C01Elz rdfs:label "Alcohol problems"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Issues related to the use of alcohol, including dependence and abuse."@en .

    hitop:C01FDy rdfs:label "Marijuana use"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "The consumption of marijuana, which may lead to problematic use."@en .

    hitop:C01GEY rdfs:label "Marijuana problems"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Issues related to the use of marijuana, including dependence and abuse."@en .

    hitop:C01HGq rdfs:label "Drug use"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "The consumption of illicit or prescription drugs, which may lead to problematic use."@en .

    hitop:C01Ip4 rdfs:label "Drug problems"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Issues related to the use of drugs, including dependence and abuse."@en .

    hitop:C01JH8 rdfs:label "Physical aggression"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Aggression involving physical acts of violence towards others."@en .

    hitop:C01KXo rdfs:label "Destructive aggression"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Aggression that results in damage to property or the environment."@en .

    hitop:C01LSp rdfs:label "Relational aggression"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Aggression that harms others through manipulation of social relationships."@en .

    hitop:C01MjB rdfs:label "Fraud"@en ;
    hitop:hasLevel "Component" ;
    rdfs:comment "Deceptive behavior intended to secure unfair or unlawful gain."@en .

    hitop:P001Y2 rdfs:label "Somatoform"@en ;
    hitop:hasLevel "Spectrum" ;
    hitop:hasTier hitop:C001qy ,
    hitop:C00217 ,
    hitop:C0033z ,
    hitop:C00416 ,
    hitop:C005Sv ,
    hitop:C006MD ;
    rdfs:comment "The Somatoform label refers to a category of mental health disorders characterized by physical symptoms that cannot be fully explained by any underlying medical condition, highlighting the complex interaction between mind and body in mental health."@en .

    hitop:P002nf rdfs:label "Internalizing"@en ;
    hitop:hasLevel "Spectrum" ;
    hitop:hasTier hitop:T007eM ,
    hitop:T008mD ,
    hitop:T0094I ,
    hitop:T00A0Z ,
    hitop:T00BXK ,
    hitop:T00Cgy ,
    hitop:T00D42 ,
    hitop:T00Eht ,
    hitop:T00Fe0 ,
    hitop:T00G3d ,
    hitop:T00HCy ,
    hitop:T00IAT ,
    hitop:U0012Y ,
    hitop:U002SC ,
    hitop:U0036N ,
    hitop:U004dm ,
    hitop:U0050q ;
    rdfs:comment "The Internalizing label refers to a category of mental health disorders characterized by inward-focused symptoms such as anxiety, depression, and withdrawal, reflecting emotional and cognitive distress."@en .

    hitop:P003SL rdfs:label "Thought Disorder"@en ;
    hitop:hasLevel "Spectrum" ;
    hitop:hasTier hitop:C00qSD ,
    hitop:C00rnS ,
    hitop:C00sWr ,
    hitop:C00tUQ ,
    hitop:T00ua9 ,
    hitop:T00vjR ,
    hitop:T00wk6 ,
    hitop:T00xLn ;
    rdfs:comment "Thought Disorder refers to a category of mental health conditions characterized by disorganized thinking, impaired reality testing, and disturbances in the form or content of thought."@en .

    hitop:P004R1 rdfs:label "Detachment"@en ;
    hitop:hasLevel "Spectrum" ;
    hitop:hasTier hitop:T00yfU ,
    hitop:T00zDk ,
    hitop:T010c6 ,
    hitop:T011K6 ,
    hitop:T012QL ,
    hitop:T013F1 ,
    hitop:T014BA ,
    hitop:T01hQc ;
    rdfs:comment "Detachment refers to a psychological state characterized by emotional distance and disengagement from social interactions."@en .

    hitop:P005xY rdfs:label "Disinhibited Externalizing"@en ;
    hitop:hasLevel "Spectrum" ;
    hitop:hasTier hitop:T015o8 ,
    hitop:T016k0 ,
    hitop:T0177S ,
    hitop:T018ir ,
    hitop:T019Cj ,
    hitop:T01A5i ,
    hitop:T01BfQ ,
    hitop:T01C1W ,
    hitop:U0061L ,
    hitop:U007EJ ;
    rdfs:comment "Disinhibited Externalizing involves behaviors that are impulsive and lacking in social restraint or inhibition."@en .

    hitop:P006gM rdfs:label "Antagonistic Externalizing"@en ;
    hitop:hasLevel "Spectrum" ;
    hitop:hasTier hitop:T01XQi ,
    hitop:T01Y7w ,
    hitop:T01Ziz ,
    hitop:T01a7u ,
    hitop:T01bz7 ,
    hitop:T01cX5 ,
    hitop:T01d9I ,
    hitop:T01eG6 ,
    hitop:T01fc8 ,
    hitop:T01gKP ;
    rdfs:comment "Antagonistic Externalizing describes behaviors that involve hostility and aggression towards others."@en .

    hitop:S0013h rdfs:label "Externalizing"@en ;
    hitop:hasLevel "Superspectrum" ;
    hitop:hasTier hitop:P005xY ,
    hitop:P006gM ;
    rdfs:comment "Represents a broad HiTOP dimension characterized by outwardly directed behaviors and dysregulation."@en .

    hitop:T007eM rdfs:label "Anxiousness"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a tendency to experience anxiety or nervousness."@en .

    hitop:T008mD rdfs:label "Emotional lability"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by rapid and intense emotional changes."@en .

    hitop:T0094I rdfs:label "Hostility"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a tendency toward aggression or antagonism."@en .

    hitop:T00A0Z rdfs:label "Perseveration"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by the repetition of a particular response despite the absence or cessation of a stimulus."@en .

    hitop:T00BXK rdfs:label "(low) Restricted affectivity"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by limited or constricted emotional expression."@en .

    hitop:T00Cgy rdfs:label "Separation insecurity"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by anxiety and insecurity in response to separation from significant others."@en .

    hitop:T00D42 rdfs:label "Submissiveness"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a tendency to submit to others and avoid asserting oneself."@en .

    hitop:T00Eht rdfs:label "Identity problems"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by difficulties in forming or maintaining a stable sense of self."@en .

    hitop:T00Fe0 rdfs:label "Negative relationships"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait of negative relationships is that they contribute to stress, conflict, or emotional harm, often undermining well-being and personal growth."@en .

    hitop:T00G3d rdfs:label "Fragility"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a lack of resilience and a tendency to be easily hurt or affected by stress."@en .

    hitop:T00HCy rdfs:label "Ineptitude"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a lack of skill or competence."@en .

    hitop:T00IAT rdfs:label "(low) Invulnerability"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a perception of being immune to harm or negative effects."@en .

    hitop:T00ua9 rdfs:label "Eccentricity"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by unconventional or peculiar behavior."@en .

    hitop:T00vjR rdfs:label "Cognitive perceptual dysregulation"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by disturbances in cognition and perception."@en .

    hitop:T00wk6 rdfs:label "Unusual beliefs and experiences"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by the presence of atypical beliefs and experiences."@en .

    hitop:T00xLn rdfs:label "Fantasy proneness"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a tendency to engage in vivid and complex fantasies."@en .

    hitop:T00yfU rdfs:label "Depressivity"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by feelings of sadness and hopelessness."@en .

    hitop:T00zDk rdfs:label "Intimacy avoidance"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a tendency to avoid close relationships and emotional intimacy."@en .

    hitop:T010c6 rdfs:label "Suspiciousness"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a tendency to be distrustful and suspicious of others."@en .

    hitop:T011K6 rdfs:label "Withdrawal"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a tendency to retreat from social interactions and avoid engagement with others."@en .

    hitop:T012QL rdfs:label "Interpersonal passivity"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a lack of initiative or assertiveness in social interactions."@en .

    hitop:T013F1 rdfs:label "Disaffiliativeness"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a lack of interest in forming or maintaining social bonds."@en .

    hitop:T014BA rdfs:label "(low) Attention seeking"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by limited motivation to attract, maintain, or enhance the attention of others, often manifested as reduced social display, self-promotion, or efforts to gain recognition."@en .

    hitop:T015o8 rdfs:label "Problematic impulsivity"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by difficulty in controlling impulsive behaviors, often leading to negative consequences."@en .

    hitop:T016k0 rdfs:label "Irresponsibility"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a lack of regard for the consequences of one's actions, often leading to reckless behavior."@en .

    hitop:T0177S rdfs:label "Theft"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a tendency to steal or engage in dishonest acquisition of property."@en .

    hitop:T018ir rdfs:label "Distractibility"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by an inability to maintain focus, leading to frequent shifts in attention."@en .

    hitop:T019Cj rdfs:label "Risk taking"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by engaging in behaviors that involve significant risk, often without regard for potential negative outcomes."@en .

    hitop:T01A5i rdfs:label "(low) Rigid perfectionism"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a low tendency toward excessive and inflexible striving for perfection and high standards."@en .

    hitop:T01BfQ rdfs:label "(low) Ruminative deliberation"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a low tendency toward excessive and repetitive thinking about potential decisions and their outcomes."@en .

    hitop:T01C1W rdfs:label "(low) Workaholism"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by reduced levels of excessive and compulsive commitment to work, with less impact on personal well-being and relationships."@en .

    hitop:T01Neb rdfs:label "Impatient urgency"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a lack of patience and a tendency to act impulsively in urgent situations."@en .

    hitop:T01OY2 rdfs:label "(low) Planful control"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait indicating poor ability to plan and execute tasks effectively."@en .

    hitop:T01PMW rdfs:label "(low) Dependability"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a lack of reliability and consistency in fulfilling obligations."@en .

    hitop:T01QNN rdfs:label "Alienation"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait reflecting a sense of estrangement or detachment from others."@en .

    hitop:T01RYG rdfs:label "Boredom proneness"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait indicating a tendency to experience boredom frequently and easily."@en .

    hitop:T01SYW rdfs:label "Blame externalization"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a tendency to attribute failures or problems to external factors rather than internal ones."@en .

    hitop:T01T3u rdfs:label "(low) Honesty"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait marked by a tendency to be deceitful or untruthful."@en .

    hitop:T01UGN rdfs:label "Rebelliousness"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by resistance to authority and norms."@en .

    hitop:T01VXq rdfs:label "(low) Empathy"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait indicating a reduced ability to understand and share the feelings of others."@en .

    hitop:T01W1E rdfs:label "Excitement seeking"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a desire for new, thrilling, or risky experiences."@en .

    hitop:T01XQi rdfs:label "Attention seeking"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait of attention seeking is the constant need for validation or recognition, often leading to behavior aimed at drawing focus from others."@en .

    hitop:T01Y7w rdfs:label "Callousness"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a lack of empathy and a tendency to be emotionally cold or indifferent to others."@en .

    hitop:T01Ziz rdfs:label "Deceitfulness"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a tendency to lie, cheat, or deceive others."@en .

    hitop:T01a7u rdfs:label "Grandiosity"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by an exaggerated sense of one's own importance, abilities, or achievements."@en .

    hitop:T01bz7 rdfs:label "Manipulativeness"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a tendency to control or influence others for personal gain, often in a devious manner."@en .

    hitop:T01cX5 rdfs:label "Rudeness"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a lack of manners or respect in social interactions."@en .

    hitop:T01d9I rdfs:label "Egocentricity"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by an excessive focus on oneself and one's own needs and desires."@en .

    hitop:T01eG6 rdfs:label "Dominance"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a desire to control or lead others, often displaying assertiveness and power."@en .

    hitop:T01fc8 rdfs:label "Flirtatiousness"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by behavior that seeks to attract romantic or sexual interest from others through playful or provocative means."@en .

    hitop:T01gKP rdfs:label "(low) Timorousness"@en ;
    hitop:hasLevel "Trait" ;
    rdfs:comment "A trait characterized by a low tendency to be fearful or lacking in confidence, often reflected in reduced shyness and hesitation."@en .

    hitop:T01hQc rdfs:label "Anhedonia"@en ;
