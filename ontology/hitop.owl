    <dcterms:modified>2025-08-19</dcterms:modified>
    <dcterms:hasVersion rdf:resource="http://purl.org/dc/terms/1.1"/>
    <dcterms:isVersionOf rdf:resource="http://purl.org/dc/terms/1.1"/>
    <dcterms:issued rdf:resource="http://purl.org/dc/terms/1.1"/>
